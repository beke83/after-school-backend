MONGODB_URI=
DB_NAME=afterschool
PORT=3000
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=After School Lessons
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack (TEST mode). Use the TEST secret key from the Paystack dashboard
# (Settings → API Keys & Webhooks); it starts with sk_test_. Never put it in the front-end.
PAYSTACK_SECRET_KEY=
# The currency Paystack charges in (test mode), and the fixed TEST rate used to turn £ into it
PAYSTACK_CURRENCY=NGN
GBP_TO_NGN=2000

# Optional: the number of a Brevo email template for the booking confirmation.
# Leave empty to send the simple built-in confirmation email instead.
BREVO_BOOKING_TEMPLATE_ID=
